# Django Settings
SECRET_KEY=
ALLOWED_HOSTS=localhost, 127.0.0.1, 0.0.0.0
STATIC_URL=/static/
MEDIA_URL=/media/
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# PostgreSQL Configuration
DB_NAME=infobus
DB_USER=
DB_PASSWORD=
DB_HOST=database
DB_PORT=5432

# Redis Configuration
REDIS_HOST=memory
REDIS_PORT=6379
REDIS_PASSWORD=changeme-use-a-strong-value
REDIS_CELERY_DB=0
# Redis database used for Django's cache and API throttling.
REDIS_CACHE_DB=1
# Timeout for outbound HTTP requests.
HTTP_REQUEST_TIMEOUT_SECONDS=10
# Rate limit for anonymous API requests.
DRF_THROTTLE_ANON_RATE=60/min
# Rate limit for geometry API requests.
DRF_THROTTLE_GEOMETRY_RATE=10/min
# Rate limit for realtime API requests.
DRF_THROTTLE_REALTIME_RATE=30/min
# Default number of results per API page.
DRF_PAGE_SIZE=100
# Number of trusted reverse proxies in front of Django.
DRF_NUM_PROXIES=1
# Maximum number of active Redis stream events retained.
REDIS_EVENTS_STREAM_MAXLEN=1000000
# Maximum number of dead-letter Redis stream events retained.
REDIS_DEAD_LETTER_STREAM_MAXLEN=10000

# NanoMQ Configuration
NANOMQ_LOG_LEVEL=INFO

# RabbitMQ Configuration
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_HOST=broker
RABBITMQ_PORT=5672

# Google Maps API Key
API_TOKEN=

# Host Machine Port Configuration
BACKEND_PORT=8001
DATABASE_PORT=15432
MEMORY_PORT=16379
CONTEXT_PORT=3278
KNOWLEDGE_PORT=3030
BROKER_AMQP_PORT=56721
BROKER_MANAGEMENT_PORT=25672
BROKER_PROMETHEUS_PORT=25692
USER_INTERFACE_PORT=23000

# Domains in production
ORCHESTRATOR_DOMAIN=api.infobus.simovilab.com
UI_DOMAIN=infobus.simovilab.com
MQTT_DOMAIN=mqtt.infobus.simovilab.com
KNOWLEDGE_DOMAIN=sparql.infobus.simovilab.com
CONTEXT_DOMAIN=mcp.infobus.simovilab.com
DOCS_DOMAIN=docs.infobus.simovilab.com

# Certificate in production
CERT_RESOLVER=letsencrypt
