# Django Settings
SECRET_KEY=
ALLOWED_HOSTS=localhost, 127.0.0.1, 0.0.0.0
STATIC_URL=/static/
MEDIA_URL=/media/
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# PostgreSQL Configuration
DB_NAME=infobus
DB_USER=
DB_PASSWORD=
DB_HOST=database
DB_PORT=5432

# Redis Configuration
REDIS_HOST=memory
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_CELERY_DB=0

# NanoMQ Configuration
NANOMQ_LOG_LEVEL=INFO

# RabbitMQ Configuration
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_HOST=broker
RABBITMQ_PORT=5672

# Google Maps API Key
API_TOKEN=

# Host Machine Port Configuration
BACKEND_PORT=8001
DATABASE_PORT=15432
MEMORY_PORT=16379
CONTEXT_PORT=3278
KNOWLEDGE_PORT=3030
BROKER_AMQP_PORT=56721
BROKER_MANAGEMENT_PORT=25672
BROKER_PROMETHEUS_PORT=25692
USER_INTERFACE_PORT=23000

# Domains in production
ORCHESTRATOR_DOMAIN=api.infobus.simovilab.com
UI_DOMAIN=infobus.simovilab.com
MQTT_DOMAIN=mqtt.infobus.simovilab.com
KNOWLEDGE_DOMAIN=sparql.infobus.simovilab.com
CONTEXT_DOMAIN=mcp.infobus.simovilab.com
BROKER_DOMAIN=rabbitmq.infobus.simovilab.com
DOCS_DOMAIN=docs.infobus.simovilab.com

# Certificate in production
CERT_RESOLVER=letsencrypt
